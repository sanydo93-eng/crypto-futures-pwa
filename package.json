{
  "name": "signals-pwa",
  "version": "0.2.0",
  "description": "Модели точного счёта в теннисе и гола в первом тайме в футболе, сигналы по расхождению с коэффициентами",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "launch": "node scripts/launch.js",
    "test": "node --test \"test/**/*.test.js\"",
    "icons": "node scripts/generate-icons.js",
    "stats": "node scripts/build-stats.js",
    "stats:football": "node scripts/build-football-stats.js",
    "backtest": "node scripts/backtest.js",
    "static": "node scripts/build-static.js --single --artifact",
    "port": "node scripts/find-port.js",
    "probe": "node scripts/probe-provider.js"
  }
}
