# Скопируй в .env и подставь свои значения:  cp .env.example .env && chmod 600 .env
# Файл .env в git не попадает — ключи в репозиторий класть нельзя.
#
# Запуск с переменными:  env $(grep -v '^#' .env | xargs) npm start
# В systemd подключается через EnvironmentFile, см. deploy/signals.service

# --- сеть ---
PORT=8100
# 0.0.0.0 обязателен для доступа с телефона: на 127.0.0.1 сервер виден
# только с самой машины.
HOST=0.0.0.0

# --- теннис ---
# mock — демо-данные без сети (работает сразу)
# api-tennis — боевой фид, нужен ключ
PROVIDER=mock
API_TENNIS_KEY=
# Справочник игроков: node scripts/build-stats.js --from 2021 --to 2025
STATS_PATH=data/player-stats.json

# Поправка вероятностей, подобранная бэктестом. Файла может не быть — это
# нормальный режим: без доказанной пользы модель работает как есть.
#   npm run backtest -- --save-calibration data/tennis-calibration.json
TENNIS_CALIBRATION_PATH=data/tennis-calibration.json

# --- футбол ---
# mock     — демо-данные с синтетической историей для раздела статистики
# odds-api — БЕСПЛАТНЫЙ: 500 запросов в месяц, ключ за минуту без карты
#            на the-odds-api.com. Рынки матча целиком: исход, тоталы, обе забьют.
# betsapi  — платный, единственный с рынками первого тайма
FOOTBALL_PROVIDER=mock

# --- The Odds API (бесплатный) ---
ODDS_API_KEY=
# Ключи лиг: soccer_epl, soccer_spain_la_liga, soccer_italy_serie_a,
# soccer_germany_bundesliga, soccer_france_ligue_one, soccer_uefa_champs_league,
# soccer_russia_premier_league. Каждая лига — отдельный запрос из лимита.
ODDS_API_LEAGUES=soccer_epl
# eu — европейские букмекеры, uk, us, au — соответственно.
ODDS_API_REGIONS=eu

# --- BetsAPI (платный) ---
BETSAPI_TOKEN=

# Рейтинги команд: node scripts/build-football-stats.js --league E0
FOOTBALL_STATS_PATH=data/football-E0.json

# BetsAPI отдаёт все лиги мира сразу, а справочник команд собирается по одной.
# Без фильтра почти все матчи посчитаются по среднему уровню лиги — то есть
# без преимущества. Фильтр по подстроке в названии лиги, через запятую.
BETSAPI_LEAGUES=England Premier League

# Сколько матчей брать за раз. Каждая пачка из 10 матчей — отдельный запрос
# к /v3/bet365/prematch, а лимит запросов в тарифе конечен.
BETSAPI_MAX_EVENTS=40

# Как часто ходить к провайдеру. Коэффициенты живут минутами,
# а лимит запросов в тарифе конечен.
CACHE_TTL_MS=120000

# --- отбор сигналов ---
# Минимальное преимущество: 0.05 = 5%. Ниже 3-4% сигнал обычно съедается
# погрешностью самой модели.
MIN_EDGE=0.05
# Не показывать исходы реже этой вероятности — там модель наименее надёжна.
MIN_PROBABILITY=0.02
# power учитывает переоценку аутсайдеров, proportional делит маржу поровну.
DEVIG_METHOD=power
# Доля от полного критерия Келли. Полный Келли слишком агрессивен.
KELLY_FRACTION=0.25
