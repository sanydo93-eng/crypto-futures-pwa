# Скопируй в .env и подставь свои значения:  cp .env.example .env
# Файл .env в git не попадает — ключи в репозиторий класть нельзя.
#
# Запуск с переменными:  env $(grep -v '^#' .env | xargs) npm start

# --- сеть ---
PORT=8100
# 0.0.0.0 обязателен для доступа с телефона: на 127.0.0.1 сервер виден
# только с самой машины.
HOST=0.0.0.0

# --- источник данных ---
# mock — демо-данные без сети (работает сразу)
# api-tennis — боевой фид, нужен ключ
PROVIDER=mock
API_TENNIS_KEY=
STATS_PATH=data/player-stats.json

# Как часто ходить к провайдеру. Коэффициенты живут минутами,
# а лимит запросов в тарифе конечен.
CACHE_TTL_MS=120000

# --- отбор сигналов ---
# Минимальное преимущество: 0.05 = 5%. Ниже 3-4% сигнал обычно съедается
# погрешностью самой модели.
MIN_EDGE=0.05
# Не показывать исходы реже этой вероятности — там модель наименее надёжна.
MIN_PROBABILITY=0.02
# power учитывает переоценку аутсайдеров, proportional делит маржу поровну.
DEVIG_METHOD=power
# Доля от полного критерия Келли. Полный Келли слишком агрессивен.
KELLY_FRACTION=0.25
