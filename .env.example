# Copy to .env on the server and fill in. Never commit .env.

# --- Telegram (обязательно) -------------------------------------------------
# Токен от @BotFather. Бота нужно добавить в канал администратором
# с правом «Публикация сообщений».
TELEGRAM_BOT_TOKEN=
# Для канала: @your_channel  либо числовой id вида -1001234567890
TELEGRAM_CHAT_ID=

# --- Рынок ------------------------------------------------------------------
# Символы KuCoin Futures: XBTUSDTM = BTC, ETHUSDTM = ETH, SOLUSDTM = SOL
SYMBOLS=XBTUSDTM,ETHUSDTM
# Таймфрейм в минутах: 1 5 15 30 60 120 240 480 720 1440 10080
GRANULARITY=15

# --- Стратегия --------------------------------------------------------------
STRATEGY=ema_rsi
# Любая переменная с префиксом STRAT_ попадает в стратегию как параметр.
STRAT_EMA_FAST=12
STRAT_EMA_SLOW=26
STRAT_RSI_PERIOD=14
STRAT_RSI_LONG_MAX=70
STRAT_RSI_SHORT_MIN=30
STRAT_ATR_PERIOD=14
STRAT_ATR_STOP_MULT=1.5
STRAT_RR_TP1=1.0
STRAT_RR_TP2=2.0

# --- Поведение --------------------------------------------------------------
# Пауза после закрытия свечи, чтобы биржа успела отдать финальные данные.
CANDLE_LAG_SECONDS=10
# 0 = проверять ровно по закрытию свечи. Иначе — каждые N секунд.
POLL_INTERVAL_SECONDS=0
# Сколько свечей молчать после сигнала в ту же сторону (разворот шлётся сразу).
COOLDOWN_CANDLES=3
HISTORY_CANDLES=300
STATE_PATH=/data/state.json
# true = считать сигналы, но писать их только в лог, ничего не слать в канал.
DRY_RUN=false
SEND_STARTUP_MESSAGE=true
LOG_LEVEL=INFO
