# Copy to .env on the server and fill in. Never commit .env.

# --- Telegram (обязательно) -------------------------------------------------
# Токен от @BotFather. Бота нужно добавить в канал администратором
# с правом «Публикация сообщений».
TELEGRAM_BOT_TOKEN=
# Для канала: @your_channel  либо числовой id вида -1001234567890
TELEGRAM_CHAT_ID=

# --- Рынок ------------------------------------------------------------------
# Символы KuCoin Futures: XBTUSDTM = BTC, ETHUSDTM = ETH, SOLUSDTM = SOL
SYMBOLS=XBTUSDTM,ETHUSDTM,SOLUSDTM
# Таймфрейм в минутах: 1 5 15 30 60 120 240 480 720 1440 10080
GRANULARITY=15

# --- Стратегия: зональный ретест FVG ----------------------------------------
STRATEGY=fvg_retest

# Публиковать только сигналы силой не ниже этого порога (0-100).
# 55 — сбалансированно, 68 — только сильные, 45 — больше сигналов и больше шума.
STRAT_MIN_STRENGTH=55
# true = торговать только по тренду старших EMA. Главный фильтр качества.
STRAT_REQUIRE_TREND=true

# Тренд и индикаторы
STRAT_TREND_FAST=50
STRAT_TREND_SLOW=200
STRAT_ATR_PERIOD=14
STRAT_RSI_PERIOD=14

# Жизнь зоны: сколько свечей она считается актуальной и сколько касаний терпим
STRAT_ZONE_MAX_AGE=60
STRAT_ZONE_MAX_TOUCHES=2
# Отсев зон по размеру относительно ATR: слишком узкие = шум, широкие = дальний стоп
STRAT_ZONE_MIN_ATR=0.10
STRAT_ZONE_MAX_ATR=4.0

# Стоп выносится за границу зоны на эту долю ATR
STRAT_STOP_BUFFER_ATR=0.25
# Цели в единицах риска (R)
STRAT_RR_TP1=1.5
STRAT_RR_TP2=3.0

# --- Управление сделкой -----------------------------------------------------
# Жёсткий потолок жизни сделки в часах (максимум 24).
MAX_HOLD_HOURS=24
# Переносить стоп в безубыток после взятия первой цели.
MOVE_STOP_TO_BREAKEVEN=true

# --- Приложение (PWA) -------------------------------------------------------
WEB_ENABLED=true
WEB_PORT=8080
# Внешний адрес приложения — попадёт ссылкой в сообщения Telegram.
# Например: https://signals.example.com  или  http://5.10.218.52:8080
APP_URL=

# --- Поведение --------------------------------------------------------------
# Пауза после закрытия свечи, чтобы биржа успела отдать финальные данные.
CANDLE_LAG_SECONDS=10
# 0 = проверять ровно по закрытию свечи. Иначе — каждые N секунд.
POLL_INTERVAL_SECONDS=0
# Сколько свечей молчать после сигнала в ту же сторону (разворот шлётся сразу).
COOLDOWN_CANDLES=3
HISTORY_CANDLES=300
# Прикладывать картинку графика к сигналу в Telegram.
SEND_CHART=true
DB_PATH=/data/signals.db
# true = считать сигналы, но писать их только в лог, ничего не слать в канал.
DRY_RUN=false
SEND_STARTUP_MESSAGE=true
LOG_LEVEL=INFO
